#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
for package in forecast-core intelligence-core; do
    if [[ ! -f "packages/$package/pyproject.toml" ]]; then
        echo "Missing packages/$package checkout. See docs/architecture.md#validation." >&2
        exit 1
    fi
done
unset PYTHONPATH UV_PROJECT_ENVIRONMENT
for app in api clio prophet intelligence; do
    started=$SECONDS
    uv sync --locked --project "apps/$app" --group test
    printf '[domain-storage] sync %s: %ss\n' "$app" "$((SECONDS - started))"
done
uv sync --locked --project tests/runtime
exec tests/runtime/.venv/bin/python scripts/testing/domain_storage.py "$@"
