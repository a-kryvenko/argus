# Anonymous operational traffic only. Never write URLs, IPs or account data here.
map $uri $argus_channel {
    default site;
    ~^/api/v1/dashboard(?:/|$) skip;
    ~^/api/ api;
    ~^/dashboard(?:/|$) skip;
    ~^/_next/ skip;
    ~*\.(?:js|css|map|png|jpg|jpeg|gif|svg|ico|webp|woff2?|ttf|txt|xml)$ skip;
}
map $http_user_agent $argus_traffic_channel {
    default $argus_channel;
    "Argus-Monitor/1" monitor;
}
map $argus_traffic_channel $argus_log_traffic {
    default 1;
    skip 0;
}
log_format argus_traffic escape=json '{"time":"$msec","channel":"$argus_traffic_channel","status":$status,"seconds":"$request_time"}';

# Only login POSTs consume this bucket. $uri is normalized (including escapes).
# real_ip below resolves the client through the trusted edge proxy before access.
map "$request_method:$uri" $argus_login_ip {
    default "";
    ~^POST:/api/v1/dashboard/login/?$ $binary_remote_addr;
}
limit_req_zone $argus_login_ip zone=argus_login:10m rate=6r/m;

server {
    listen 80;
    listen [::]:80;
    server_name www.${APP_NAME};

    return 301 http://${APP_NAME}$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${APP_NAME};

    set_real_ip_from 172.20.0.0/16;
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    include /etc/nginx/includes/default.conf;
}
