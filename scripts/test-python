#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export PYTHONPATH="$PWD/apps/api:$PWD/apps/clio/src:$PWD/apps/prophet/src:$PWD/packages/common/src:$PWD/packages/clio/src:$PWD/packages/forecast/src:$PWD/packages/forecast-core/src${PYTHONPATH:+:$PYTHONPATH}"
exec .venv/bin/python -m pytest tests packages/clio/tests packages/forecast/tests apps/api/tests apps/clio/tests apps/prophet/tests packages/forecast-core/tests "$@"
