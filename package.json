{
  "name": "argus-sunwatch",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev dev:solar-wind dev:geomagnetic --concurrency 7",
    "dev:api": "turbo run dev --filter=api",
    "dev:web": "turbo run dev --filter=web",
    "db:migrate": "./argus api migrate",
    "db:current": "./argus api migration current",
    "db:rollback": "./argus api migration downgrade -1",
    "db:revision": "./argus api migration create --autogenerate -m",
    "app:aggregate-solar-wind": "./argus clio aggregate",
    "app:audit-solar-wind": "./scripts/dev/run clio audit",
    "app:cleanup-solar-wind": "./scripts/dev/run clio cleanup",
    "app:geomagnetic": "./argus clio refresh geomagnetic",
    "app:solar-wind": "./argus clio refresh solar-wind",
    "app:observations": "./argus clio refresh observations",
    "app:forecast": "./argus prophet refresh",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "app:user": "./argus api user",
    "app:prophet": "./argus prophet",
    "db:clio:migrate": "./argus clio migrate",
    "db:bootstrap": "./argus db provision --apply"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
