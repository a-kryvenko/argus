{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "title": "Argus Sunwatch · Website traffic",
  "uid": "argus-website-traffic",
  "tags": [
    "argus",
    "nginx"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "surface",
        "label": "Surface",
        "type": "custom",
        "query": "page,api,static,health",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "traffic",
        "label": "Traffic",
        "type": "custom",
        "query": "other,automated,probe",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "status_class",
        "label": "HTTP status",
        "type": "custom",
        "query": "1xx,2xx,3xx,4xx,5xx,other",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests in range",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"nginx-requests\"} | json surface=\"surface\", traffic=\"traffic\", status_class=\"status_class\" | __error__=\"\" | surface=~\"${surface:regex}\" | traffic=~\"${traffic:regex}\" | status_class=~\"${status_class:regex}\" [$__range])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"nginx-requests\"} | json surface=\"surface\", traffic=\"traffic\", status_class=\"status_class\" | __error__=\"\" | surface=~\"${surface:regex}\" | traffic=~\"${traffic:regex}\" | status_class=~\"${status_class:regex}\" | status_class=\"5xx\" [$__range])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Likely probes",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"nginx-requests\"} | json surface=\"surface\", traffic=\"traffic\", status_class=\"status_class\" | __error__=\"\" | surface=~\"${surface:regex}\" | traffic=~\"${traffic:regex}\" | status_class=~\"${status_class:regex}\" | traffic=\"probe\" [$__range])) or vector(0)",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Requests/min by surface",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "60 * sum by (surface) (rate({job=\"nginx-requests\"} | json surface=\"surface\", traffic=\"traffic\", status_class=\"status_class\" | __error__=\"\" | surface=~\"${surface:regex}\" | traffic=~\"${traffic:regex}\" | status_class=~\"${status_class:regex}\" [5m]))",
          "legendFormat": "{{surface}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Requests/min by HTTP status",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "60 * sum by (status_class) (rate({job=\"nginx-requests\"} | json surface=\"surface\", traffic=\"traffic\", status_class=\"status_class\" | __error__=\"\" | surface=~\"${surface:regex}\" | traffic=~\"${traffic:regex}\" | status_class=~\"${status_class:regex}\" [5m]))",
          "legendFormat": "{{status_class}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Request latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {job=\"nginx-requests\"} | json surface=\"surface\", traffic=\"traffic\", status_class=\"status_class\", request_time=\"request_time\" | __error__=\"\" | surface=~\"${surface:regex}\" | traffic=~\"${traffic:regex}\" | status_class=~\"${status_class:regex}\" | unwrap request_time | __error__=\"\" [15m]) by (surface)",
          "legendFormat": "{{surface}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "description": "End-to-end time at the site Nginx over a 15-minute window."
    },
    {
      "id": 7,
      "title": "Top request paths",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "topk(12, sum by (method, path) (count_over_time({job=\"nginx-requests\"} | json surface=\"surface\", traffic=\"traffic\", status_class=\"status_class\", method=\"method\", path=\"path\" | __error__=\"\" | surface=~\"${surface:regex}\" | traffic=~\"${traffic:regex}\" | status_class=~\"${status_class:regex}\" [$__range])))",
          "legendFormat": "{{method}} {{path}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 8,
      "title": "Top client IPs",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "topk(12, sum by (ip) (count_over_time({job=\"nginx-requests\"} | json surface=\"surface\", traffic=\"traffic\", status_class=\"status_class\", ip=\"ip\" | __error__=\"\" | surface=~\"${surface:regex}\" | traffic=~\"${traffic:regex}\" | status_class=~\"${status_class:regex}\" [$__range])))",
          "legendFormat": "{{ip}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 9,
      "title": "Recent requests",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "{job=\"nginx-requests\"} | json surface=\"surface\", traffic=\"traffic\", status_class=\"status_class\", method=\"method\", status=\"status\", path=\"path\", request_time=\"request_time\", upstream=\"upstream\", ip=\"ip\", edge_ip=\"edge_ip\", user_agent=\"user_agent\", request_id=\"request_id\", upstream_time=\"upstream_time\", upstream_status=\"upstream_status\" | __error__=\"\" | surface=~\"${surface:regex}\" | traffic=~\"${traffic:regex}\" | status_class=~\"${status_class:regex}\" | line_format \"{{.method}} {{.status}} {{.path}}  {{.request_time}}s  {{.ip}}  {{.upstream}}\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A",
          "maxLines": 150
        }
      ],
      "description": "Expand a line for upstream timings, user agent, edge IP and request ID.",
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
