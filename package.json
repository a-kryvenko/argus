{
  "name": "argus-sunwatch",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev dev:solar-wind dev:geomagnetic --concurrency 6",
    "dev:api": "turbo run api:dev",
    "dev:web": "turbo run dev --filter=web",
    "db:migrate": "./scripts/db upgrade head",
    "db:current": "./scripts/db current",
    "db:rollback": "./scripts/db downgrade -1",
    "db:revision": "./scripts/db revision --autogenerate -m",
    "app:aggregate-solar-wind": "./scripts/clio aggregate",
    "app:audit-solar-wind": "./scripts/clio audit",
    "app:cleanup-solar-wind": "./scripts/clio cleanup",
    "app:geomagnetic": "./scripts/clio collect geomagnetic",
    "app:solar-wind": "./scripts/clio collect solar-wind",
    "app:observations": "./scripts/clio refresh",
    "app:forecast": "./scripts/prophet generate",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "app:user": "cd apps/api && .venv/bin/python -m app.commands.manage_user",
    "app:prophet": "./scripts/prophet",
    "db:clio:migrate": "./scripts/clio migrate upgrade head",
    "db:bootstrap": "./scripts/domain-db --apply"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
