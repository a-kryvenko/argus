{
  "name": "argus-sunwatch",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency 4",
    "dev:api": "turbo run api:dev",
    "dev:web": "turbo run dev --filter=web",
    "db:migrate": "./scripts/db upgrade head",
    "db:current": "./scripts/db current",
    "db:rollback": "./scripts/db downgrade -1",
    "db:revision": "./scripts/db revision --autogenerate -m",
    "app:forecast": "cd apps/api && .venv/bin/python -m app.commands.generate_forecast",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
