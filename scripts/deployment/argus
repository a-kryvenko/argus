#!/usr/bin/env bash
# Installed at /var/www/bin/argus; works from any current directory.
set -euo pipefail
project_root="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"
compose=(docker compose --project-directory "$project_root" --env-file "$project_root/.env" --env-file "$project_root/.env.local")
if [[ -f "$project_root/.release-images.env" ]]; then
    compose+=(--env-file "$project_root/.release-images.env")
fi
compose+=(-f "$project_root/docker-compose.yml")
case "${1:-}" in
    prophet|clio)
        exec 9>"$project_root/.deployment.lock"
        flock -sn 9
        domain="$1"
        shift
        exec "${compose[@]}" run --rm --no-deps "$domain" "$domain" "$@"
        ;;
    compose)
        shift
        exec "${compose[@]}" "$@"
        ;;
    *)
        echo 'Usage: argus prophet <command> | argus clio <command> | argus compose <arguments>' >&2
        exit 2
        ;;
esac
