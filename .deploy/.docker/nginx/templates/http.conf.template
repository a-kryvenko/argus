# Only login POSTs consume this bucket. $uri is normalized (including escapes).
# real_ip below resolves the client through the trusted edge proxy before access.
map "$request_method:$uri" $argus_login_ip {
    default "";
    ~^POST:/api/v1/dashboard/login/?$ $binary_remote_addr;
}
limit_req_zone $argus_login_ip zone=argus_login:10m rate=6r/m;

map $request_uri $argus_request_path {
    ~^([^?]+) $1;
    default "";
}

map $uri $argus_surface {
    default page;
    ~^/(api/v1/)?health/ health;
    ~^/api/ api;
    ~^/(?:_next/static/|favicon\.ico$|robots\.txt$) static;
}

map $argus_request_path $argus_probe {
    default 0;
    ~*\.php(?:/|$) 1;
    ~*^/(?:wp-admin|wp-includes|wp-content|\.env|\.git|cgi-bin)(?:[/.]|$) 1;
}

map "$argus_probe:$http_user_agent" $argus_traffic {
    default other;
    ~^1: probe;
    ~*^0:.*(?:bot|crawler|spider|headless|uptime) automated;
}

map $status $argus_status_class {
    default other;
    ~^1 1xx;
    ~^2 2xx;
    ~^3 3xx;
    ~^4 4xx;
    ~^5 5xx;
}

# Use CF-Connecting-IP only after the trusted nginx-proxy forwarded a Cloudflare peer.
geo $realip_remote_addr $argus_trusted_edge {
    default 0;
    172.20.0.0/16 1;
    127.0.0.1 1;
}

geo $remote_addr $argus_cloudflare_peer {
    default 0;
    # https://www.cloudflare.com/ips/
    173.245.48.0/20 1;
    103.21.244.0/22 1;
    103.22.200.0/22 1;
    103.31.4.0/22 1;
    141.101.64.0/18 1;
    108.162.192.0/18 1;
    190.93.240.0/20 1;
    188.114.96.0/20 1;
    197.234.240.0/22 1;
    198.41.128.0/17 1;
    162.158.0.0/15 1;
    104.16.0.0/13 1;
    104.24.0.0/14 1;
    172.64.0.0/13 1;
    131.0.72.0/22 1;
    2400:cb00::/32 1;
    2606:4700::/32 1;
    2803:f800::/32 1;
    2405:b500::/32 1;
    2405:8100::/32 1;
    2a06:98c0::/29 1;
    2c0f:f248::/32 1;
}

map "$argus_trusted_edge:$argus_cloudflare_peer:$http_cf_connecting_ip" $argus_client_ip {
    default $remote_addr;
    "~^1:1:(?<argus_cf_client>[0-9a-fA-F.:]{3,45})$" $argus_cf_client;
}

log_format argus_requests escape=json
    '{"timestamp":"$msec","request_id":"$request_id","site":"$host",'
    '"method":"$request_method","path":"$argus_request_path","status":"$status",'
    '"status_class":"$argus_status_class","surface":"$argus_surface","traffic":"$argus_traffic",'
    '"request_time":"$request_time","bytes":"$body_bytes_sent",'
    '"upstream":"$upstream_http_x_argus_upstream","upstream_status":"$upstream_status",'
    '"upstream_time":"$upstream_response_time","ip":"$argus_client_ip",'
    '"edge_ip":"$remote_addr","user_agent":"$http_user_agent"}';

upstream argus_public_api {
    server application-router:8104;
    keepalive 16;
}

upstream argus_public_frontend {
    server application-router:8105;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name www.${APP_NAME};

    access_log /var/www/log/requests.jsonl argus_requests;
    return 301 http://${APP_NAME}$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${APP_NAME};

    set_real_ip_from 172.20.0.0/16;
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    include /etc/nginx/includes/default.conf;
}
