#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
service="${1:-}"
if [[ -n "$service" && "$service" != -* ]]; then
    case "$service" in api|clio|prophet|intelligence) ;; *) echo 'Unknown service' >&2; exit 2 ;; esac
    shift
    files=("$root/data/logs/$service.log")
else
    shopt -s nullglob
    files=("$root"/data/logs/*.log)
fi
args=(-n 100)
while (($#)); do
    case "$1" in
        -f|--follow) args+=(-F); shift ;;
        --tail) [[ ${2:-} =~ ^[0-9]+$ ]] || exit 2; args+=(-n "$2"); shift 2 ;;
        *) echo 'Usage: ./argus logs [service] [--tail N] [-f]' >&2; exit 2 ;;
    esac
done
((${#files[@]})) || { echo 'No local logs yet; start services with pnpm dev.'; exit 0; }
exec tail "${args[@]}" -- "${files[@]}"
