#!/usr/bin/env bash
set -euo pipefail
root="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
mode=dev
[[ ! -f "$root/.argus-mode" ]] || read -r mode < "$root/.argus-mode"
case "$mode" in dev|prod) ;; *) echo 'Invalid .argus-mode: expected dev or prod' >&2; exit 2 ;; esac
backend="$root/scripts/run"
usage() {
    cat <<HELP
Usage: ./argus <command> (environment: $mode)
  db provision [--apply] | db migrate
  <service> migrate
  <service> migration create -m MESSAGE [--autogenerate] (dev only)
  <service> migration current | history | downgrade REVISION
  clio collect [METRIC ...] | clio normalize
  clio backfill [METRIC ...] [--from DATE --to DATE]
  clio aggregate [--limit N] | clio status | clio worker
  prophet refresh [all|solar-wind-speed|solar-wind-density|geomagnetic-activity|dst|hmf|atmospheric-density]
  prophet status [PRODUCT]
  observe [solar-wind-speed|solar-wind-density|geomagnetic-activity|dst|hmf|all]
  demo [SCENARIO] [--refresh-data] (default: january-2026)
  prophet verify [PRODUCT] [--days 7] | prophet verification-report [PRODUCT] [--days 7]
  intelligence refresh [PRODUCT] | intelligence status [PRODUCT]
  api user <arguments>
  logs [SERVICE] [--tail N] [-f]
  compose <Docker Compose arguments>
  help [command]
Services: api, clio, prophet, intelligence.
refresh runs once; omitted product/source means all supported products/sources.
HELP
}
fail() { echo "$*" >&2; exit 2; }
run() { "$backend" "$@"; }
case "${1:-help}" in
    help|-h|--help) usage; exit 0 ;;
    compose) shift; exec "$backend" compose "$@" ;;
    logs) shift; exec "$root/scripts/logs" "$@" ;;
    demo) shift; exec "$backend" prophet demo "$@" ;;
    observe)
        shift
        [[ $# -le 1 ]] || fail 'Usage: ./argus observe [product]'
        selection="${1:-solar-wind-speed}"
        case "$selection" in solar-wind-speed|solar-wind-density|geomagnetic-activity|dst|hmf|all) ;; *) fail 'No observation verification protocol for this product' ;; esac
        run clio collect
        run clio aggregate
        run clio normalize
        if [[ "$selection" == all ]]; then
            for product in solar-wind-speed solar-wind-density geomagnetic-activity dst hmf; do
                run prophet generate "$product"
            done
        else
            run prophet generate "$selection"
        fi
        run prophet verify "$selection"
        run prophet verification-report "$selection"
        exit ;;
    db)
        shift
        case "${1:-}" in
            migrate) [[ $# == 1 ]] || fail 'Usage: ./argus db migrate' ;;
            provision) [[ $# == 1 || ( $# == 2 && "$2" == --apply ) ]] || fail 'Usage: ./argus db provision [--apply]' ;;
            *) fail 'Expected db migrate or db provision' ;;
        esac
        exec "$backend" db "$@" ;;
    api|clio|prophet|intelligence) service="$1"; shift ;;
    *) fail 'Unknown command; use ./argus help' ;;
esac
command="${1:-}"; [[ $# == 0 ]] || shift
case "$command" in
    migrate)
        [[ $# == 0 ]] || fail 'Use migration current/history/create/downgrade; migrate applies head'
        exec "$backend" "$service" migrate upgrade head ;;
    migration)
        action="${1:-}"; [[ $# == 0 ]] || shift
        case "$action" in
            create)
                [[ "$mode" == dev ]] || fail 'Migration creation is available only in dev'
                message=false
                args=("$@")
                while (($#)); do
                    case "$1" in
                        -m|--message) [[ $# -ge 2 && -n "$2" ]] || fail 'Specify -m MESSAGE'; message=true; shift 2 ;;
                        --autogenerate)
                            [[ "$service" == api || "$service" == clio ]] || fail 'This service uses handwritten migrations; omit --autogenerate'
                            shift ;;
                        *) fail 'Usage: migration create -m MESSAGE [--autogenerate]' ;;
                    esac
                done
                [[ "$message" == true ]] || fail 'Specify -m MESSAGE'
                set -- "${args[@]}"
                exec "$backend" "$service" migrate revision "$@" ;;
            current|history) exec "$backend" "$service" migrate "$action" "$@" ;;
            downgrade) [[ $# == 1 ]] || fail 'Specify one target revision'; exec "$backend" "$service" migrate downgrade "$@" ;;
            *) fail 'Expected migration create/current/history/downgrade' ;;
        esac ;;
    *) exec "$backend" "$service" "$command" "$@" ;;
esac
