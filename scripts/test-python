#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
unset PYTHONPATH UV_PROJECT_ENVIRONMENT
for app in api clio prophet intelligence; do
    uv sync --locked --project "apps/$app" --group test
    "apps/$app/.venv/bin/python" -m pytest --rootdir=. --confcutdir=. --import-mode=importlib -rs -n 8 "apps/$app/tests" "$@"
done
uv sync --locked --project tests/runtime
tests/runtime/.venv/bin/python -m pytest --rootdir=. --confcutdir=. --import-mode=importlib -rs -n 8 tests "$@"
for package in common forecast forecast-core intelligence-core; do
    extras=()
    if [[ "$package" == forecast-core ]]; then extras=(--extra models --extra datasets); fi
    uv sync --locked --project "packages/$package" --group test "${extras[@]}"
    "packages/$package/.venv/bin/python" -m pytest --rootdir=. --confcutdir=. --import-mode=importlib -rs -n 8 "packages/$package/tests" "$@"
done
uv sync --locked --project scripts/training
scripts/training/.venv/bin/python -m pytest --rootdir=. --confcutdir=. --import-mode=importlib -rs -n 8 scripts/training/tests "$@"
