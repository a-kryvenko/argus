#!/usr/bin/env bash
# Shared command adapter for dev and production.
set -euo pipefail
root="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"
mode=dev
[[ ! -f "$root/.argus-mode" ]] || read -r mode < "$root/.argus-mode"
case "$mode" in dev|prod) ;; *) echo 'Invalid .argus-mode: expected dev or prod' >&2; exit 2 ;; esac
if [[ "${1:-}" == demo ]]; then
    [[ "$mode" == dev ]] || { echo 'Demo rebuild is disabled in production; deploy a locally generated bundle.' >&2; exit 2; }
    shift
    demo_python="$root/notebooks/.venv/bin/python"
    [[ -x "$demo_python" ]] || { echo 'Demo rebuild requires the private notebooks checkout and its Python environment.' >&2; exit 2; }
    cd "$root"
    exec "$demo_python" -m notebooks.workflows.demo.rebuild "$@"
fi
compose=(docker compose --project-directory "$root")
for file in "$root/.env" "$root/.env.local"; do
    if [[ "$mode" == prod || -f "$file" ]]; then compose+=(--env-file "$file"); fi
done
if [[ "$mode" == prod ]]; then
    for file in .rolling-state.json .rolling-compose.json .release-compose.json; do
        [[ -f "$root/$file" ]] || { echo "Missing production deployment file: $file" >&2; exit 2; }
    done
    compose_file="$root/.rolling-compose.json"
    template_file="$root/.release-compose.json"
else
    export LOCAL_UID="${LOCAL_UID:-$(id -u)}" LOCAL_GID="${LOCAL_GID:-$(id -g)}"
    compose_file="$root/docker-compose.yml"
    template_file="$compose_file"
fi
templates=("${compose[@]}" -f "$template_file")
compose+=(-f "$compose_file")
usage() {
    echo 'Usage: argus db provision [--apply] | db migrate | api migrate <arguments> | api user <arguments> | clio <arguments> | prophet <arguments> | intelligence <arguments> | compose <arguments>'
}
lock() {
    [[ "$mode" == prod ]] || return 0
    exec 9>"$root/.deployment.lock"
    flock "-$1n" 9
}
cleanup_migration_database() {
    local status=$? cleanup_status=0
    trap - EXIT
    "${compose[@]}" stop postgres || cleanup_status=$?
    if (( status == 0 )); then status=$cleanup_status; fi
    exit "$status"
}
prepare_migration_database() {
    # Production infrastructure is managed by deployment. Dev may be stopped.
    [[ "$mode" == dev ]] || return 0
    local running
    running=$("${compose[@]}" ps --status running -q postgres)
    if [[ -z "$running" ]]; then
        # Install cleanup before startup: even an unhealthy start needs stopping.
        trap cleanup_migration_database EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        "${compose[@]}" up -d --wait --wait-timeout 60 postgres
    fi
}
migrate() {
    local domain="$1" target="$1"
    shift
    [[ "$mode" != prod ]] || target+="-migrate"
    "${templates[@]}" run --rm --no-deps "$target" alembic "$@"
}
case "${1:-}" in
    -h|--help|'') usage; exit 0 ;;
    db)
        shift
        case "${1:-}" in
            provision)
                shift
                lock x
                exec "${templates[@]}" run --rm --no-deps db-provision .venv/bin/python /var/www/scripts/db/provision.py "$@"
                ;;
            migrate)
                shift
                [[ $# == 0 ]] || { usage >&2; exit 2; }
                lock x
                prepare_migration_database
                for domain in api clio prophet intelligence; do migrate "$domain" upgrade head; done
                ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    api|clio|prophet|intelligence)
        domain="$1"
        shift
        if [[ "${1:-}" == migrate ]]; then
            shift
            lock x
            prepare_migration_database
            migrate "$domain" "$@"
        elif [[ "$domain" == api ]]; then
            case "${1:-}" in
                user)
                    shift
                    lock s
                    exec "${templates[@]}" run --rm --no-deps api api user "$@"
                    ;;
                serve)
                    [[ "$mode" == dev ]] || { usage >&2; exit 2; }
                    shift
                    exec "${compose[@]}" run --rm --no-deps --service-ports api api serve "$@"
                    ;;
                *) usage >&2; exit 2 ;;
            esac
        else
            lock s
            if [[ "$domain" == clio || "$domain" == prophet ]]; then
                cron_options=()
                if [[ -n "${ARGUS_CRON_JOB:-}" ]]; then cron_options+=(-e "ARGUS_CRON_JOB=$ARGUS_CRON_JOB"); fi
                exec "${templates[@]}" run --rm --no-deps -T "${cron_options[@]}" "$domain" "$domain" "$@"
            fi
            exec "${templates[@]}" run --rm --no-deps "$domain" "$domain" "$@"
        fi
        ;;
    compose)
        shift
        if [[ "$mode" == prod ]]; then
            case "${1:-}" in
                exec|logs|run|restart|start|stop|kill|pause|unpause|top|rm|ps|up)
                    mapfile -d '' -t mapped < <(python3 - "$root/.rolling-state.json" "$@" <<'PY'
import json, sys
state = json.load(open(sys.argv[1]))['active']
arguments = sys.argv[2:]
command = arguments[0]
value_options = {'--index', '--user', '-u', '--workdir', '-w', '--env', '-e', '--name',
                 '--publish', '-p', '--entrypoint', '--label', '-l', '--tail', '--since',
                 '--until', '--timeout', '--wait-timeout', '--scale', '--exit-code-from',
                 '--attach', '--no-attach', '--pull', '--format'}
if command in {'up', 'stop', 'restart'}:
    value_options.add('-t')
positions, skip = [], False
for index, value in enumerate(arguments[1:], 1):
    if skip:
        skip = False
        continue
    if value in value_options:
        skip = True
        continue
    if value.startswith('-'):
        continue
    positions.append(index)
    if command in {'run', 'exec'}:
        break
if command == 'up' and not positions:
    print('Production up requires explicit services; use the release deployment for upgrades.', file=sys.stderr)
    raise SystemExit(2)
for index in positions:
    entry = state.get(arguments[index])
    if entry and entry['slot']:
        arguments[index] += '-' + entry['slot']
for value in arguments:
    sys.stdout.buffer.write(value.encode() + b'\0')
PY
                    )
                    ((${#mapped[@]})) || exit 2
                    set -- "${mapped[@]}"
                    ;;
            esac
        fi
        exec "${compose[@]}" "$@"
        ;;
    *) usage >&2; exit 2 ;;
esac
