{
  "name": "argus-sunwatch",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev dev:solar-wind dev:geomagnetic --concurrency 7",
    "dev:api": "turbo run dev --filter=api",
    "dev:web": "turbo run dev --filter=web",
    "db:migrate": "./scripts/argus api migrate upgrade head",
    "db:current": "./scripts/argus api migrate current",
    "db:rollback": "./scripts/argus api migrate downgrade -1",
    "db:revision": "./scripts/argus api migrate revision --autogenerate -m",
    "app:aggregate-solar-wind": "./scripts/argus clio aggregate",
    "app:audit-solar-wind": "./scripts/argus clio audit",
    "app:cleanup-solar-wind": "./scripts/argus clio cleanup",
    "app:geomagnetic": "./scripts/argus clio collect geomagnetic",
    "app:solar-wind": "./scripts/argus clio collect solar-wind",
    "app:observations": "./scripts/argus clio refresh",
    "app:forecast": "./scripts/argus prophet generate",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "app:user": "./scripts/argus api user",
    "app:prophet": "./scripts/argus prophet",
    "db:clio:migrate": "./scripts/argus clio migrate upgrade head",
    "db:bootstrap": "./scripts/argus db provision --apply"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
